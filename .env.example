# Copy sang .env (hoặc đặt trực tiếp trong docker-compose.yml / biến môi trường
# của server) rồi điền giá trị thật. Không commit file .env thật.

# Khóa ký session cookie nội bộ — đổi sang chuỗi ngẫu nhiên bí mật ở production.
SESSION_SECRET=doi-chuoi-nay-o-production

# Bật cookie Secure khi app chạy sau HTTPS thật (bắt buộc cho Google OAuth
# redirect_uri ở production, vì Google yêu cầu HTTPS trừ localhost lúc dev).
COOKIE_SECURE=false

# ---------- Google OAuth 2.0 — đăng nhập Admin/Sup/HRBP ----------
# Tạo tại https://console.cloud.google.com/apis/credentials
# 1. Tạo OAuth client ID, loại "Web application"
# 2. Authorized redirect URI = đúng giá trị GOOGLE_REDIRECT_URI bên dưới
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phải khớp chính xác với Authorized redirect URI đã khai báo ở Google Cloud,
# dạng: https://<domain-app-cua-ban>/api/auth/google/callback
# (Google cho phép http://localhost:PORT/... khi test cục bộ.)
GOOGLE_REDIRECT_URI=

# Chỉ chấp nhận tài khoản Google Workspace thuộc domain này
GOOGLE_HD_DOMAIN=ghn.vn
